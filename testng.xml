<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  One test CLASS (CrossFrameworkTest) is reused unchanged across three
  <test> blocks. Only the "framework" parameter differs - this is what
  "runs unchanged against React, Vue, and Angular" means concretely:
  same bytecode, same assertions, same generator, different target URL.

  Override seed at the CLI to change the run without editing this file:
    mvn test -DsuiteXmlFile=testng.xml -Dseed=1234
-->
<suite name="TodoMVC-CrossFramework-Suite" verbose="1" parallel="tests" thread-count="3">

    <test name="React">
        <parameter name="framework" value="react"/>
        <classes>
            <class name="com.todomvc.tests.CrossFrameworkTest"/>
        </classes>
    </test>

    <test name="Vue">
        <parameter name="framework" value="vue"/>
        <classes>
            <class name="com.todomvc.tests.CrossFrameworkTest"/>
        </classes>
    </test>

    <test name="Angular">
        <parameter name="framework" value="angular"/>
        <classes>
            <class name="com.todomvc.tests.CrossFrameworkTest"/>
        </classes>
    </test>

</suite>
